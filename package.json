{
  "name": "cff-ball-pit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check:godot": "godot --headless --path . --editor --quit",
    "test:unit": "godot --headless --path . --script tests/unit_runner.gd",
    "test:smoke": "node tests/smoke.mjs",
    "test:camera": "node tests/camera-smoke.mjs",
    "test:all": "npm test && npm run test:camera",
    "test": "npm run check:godot && npm run test:unit && npm run test:smoke",
    "mcp-server": "node adapters/mcp-server.mjs",
    "server": "node tools/launch.mjs server",
    "play": "node tools/launch.mjs play",
    "players": "node tools/launch.mjs players"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.24.0",
    "ai": "^6.0.193",
    "zod": "^3.24.2"
  }
}
